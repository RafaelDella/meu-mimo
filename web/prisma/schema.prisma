generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

enum MembershipRole {
  MERCHANT
  PARTICIPANT

  @@schema("app")
}

enum StoreState {
  ACTIVE
  PAUSED
  CLOSED

  @@schema("app")
}

enum ConversationSubject {
  SUBMISSION
  TICKET

  @@schema("app")
}

enum NotificationKind {
  INVITATION_ACCEPTED
  COMMENT_CREATED
  SUBMISSION_RECEIVED
  SUBMISSION_REVIEWED
  SUBMISSION_RESPONDED
  REDEMPTION_ISSUED
  REDEMPTION_UPDATED
  ALBUM_PUBLISHED
  NOTE_SENT
  REACTION_CHANGED

  @@schema("app")
}

enum ActivityFrequency {
  ONCE
  DAILY
  WEEKLY
  @@schema("app")
}

enum ApprovalMode {
  MANUAL
  AUTOMATIC
  @@schema("app")
}

enum RedemptionStatus {
  WAITING_AGREEMENT
  AGREED
  FULFILLED
  CANCELLATION_REQUESTED
  CANCELLED
  @@schema("app")
}

enum SubmissionStatus {
  DRAFT
  PENDING
  APPROVED
  CONTESTED
  VOIDED
  @@schema("app")
}

enum MediaPurpose {
  EVIDENCE
  MEMORY
  @@schema("app")
}

enum MediaType {
  PHOTO
  VIDEO
  @@schema("app")
}

enum MediaState {
  UPLOADING
  QUEUED
  PROCESSING
  READY
  FAILED
  REMOVING
  REMOVED
  @@schema("app")
}

model Profile {
  id             String          @id @db.Uuid
  displayName    String?
  suspendedAt    DateTime?       @db.Timestamptz(6)
  securityVersion Int @default(dbgenerated("0"))
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  authoredStores Store[]
  memberships    Membership[]
  adminGrant     AdminGrant?
  authSessions   AuthSession[]
  securityAudits SecurityAudit[]
  createdInvitations Invitation[] @relation("InvitationCreator")
  acceptedInvitations Invitation[] @relation("InvitationAcceptor")
  storeAudits StoreAudit[]
  authoredComments Comment[]
  mediaAssets MediaAsset[]
  outboxEvents OutboxEvent[]

  authoredActivities Activity[]
  activityEvents ActivityEvent[]
  authoredSubmissions ActivitySubmission[]
  submissionEvents SubmissionEvent[]
  pointsEntries PointsEntry[]
  reviewEvents SubmissionReviewEvent[]
  authoredRewards Reward[]
  rewardEvents RewardEvent[]
  authoredRedemptions Redemption[]
  redemptionEvents RedemptionEvent[]
  createdAlbums TicketAlbum[]
  albumEvents AlbumEvent[]
  noteVersions NoteVersion[]
  noteReads NoteRead[]
  reactions Reaction[]
  reactionEvents ReactionEvent[]
  notificationGroups NotificationGroup[]
  preferenceEvents NotificationPreferenceEvent[]
  adminActions AdminAction[] @relation("AdminActor")
  securityActions AdminAction[] @relation("AdminTargetProfile")
  rightsRequests DataRightsProtocol[] @relation("RightsSubject")
  operatedRights DataRightsProtocol[] @relation("RightsOperator")
  dataSuppressions DataSuppression[]

  @@schema("app")
}

model Store {
  id                 String       @id @default(uuid()) @db.Uuid
  createdByProfileId String       @db.Uuid
  name               String?
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  presentation       String       @default("")
  timezone           String       @default("America/Sao_Paulo")
  state              StoreState   @default(ACTIVE)
  pausedAt           DateTime?    @db.Timestamptz(6)
  platformPausedAt DateTime? @db.Timestamptz(6)
  platformVersion Int @default(0)
  closedAt           DateTime?    @db.Timestamptz(6)
  domainStartedAt    DateTime?    @db.Timestamptz(6)
  operationId        String?      @unique @db.Uuid
  creationDigest     String?
  createdBy          Profile      @relation(fields: [createdByProfileId], references: [id], onDelete: Restrict)
  memberships        Membership[]
  invitations        Invitation[]
  audits             StoreAudit[]
  conversations Conversation[]
  mediaCollections MediaCollection[]
  outboxEvents OutboxEvent[]

  activities Activity[]
  activityEvents ActivityEvent[]
  submissions ActivitySubmission[]
  submissionEvents SubmissionEvent[]
  pointsEntries PointsEntry[]
  reviewEvents SubmissionReviewEvent[]
  rewards Reward[]
  rewardEvents RewardEvent[]
  redemptions Redemption[]
  redemptionEvents RedemptionEvent[]
  ticketAlbums TicketAlbum[]
  albumEvents AlbumEvent[]
  personalNotes PersonalNote[]
  noteVersions NoteVersion[]
  reactions Reaction[]
  reactionEvents ReactionEvent[]
  notificationGroups NotificationGroup[]
  notificationPreferences NotificationPreference[]
  preferenceEvents NotificationPreferenceEvent[]
  adminActions AdminAction[]

  @@index([createdByProfileId])
  @@schema("app")
}

model Membership {
  id              String         @id @default(uuid()) @db.Uuid
  storeId         String         @db.Uuid
  profileId       String         @db.Uuid
  role            MembershipRole
  accessRevokedAt DateTime?      @db.Timestamptz(6)
  closedAt        DateTime?      @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  profile         Profile        @relation(fields: [profileId], references: [id], onDelete: Restrict)
  acceptedInvitations Invitation[]
  invitationUses InvitationUse[]
  participantConversations Conversation[]
  mediaCollections MediaCollection[]
  participantEvents OutboxEvent[] @relation("EventParticipant")
  receivedEvents OutboxEvent[] @relation("EventRecipient")
  submissions ActivitySubmission[]
  pointsEntries PointsEntry[]

  redemptions Redemption[]
  ticketAlbums TicketAlbum[]
  personalNote PersonalNote?
  noteVersions NoteVersion[]
  noteReads NoteRead[]
  notificationGroups NotificationGroup[]
  notificationPreference NotificationPreference?
  preferenceEvents NotificationPreferenceEvent[]

  @@unique([storeId, profileId])
  @@unique([id, storeId])
  @@unique([id, profileId])
  @@unique([id, storeId, profileId])
  @@index([profileId, accessRevokedAt])
  @@index([storeId, accessRevokedAt])
  @@schema("app")
}

model Invitation {
  id                   String @id @db.Uuid
  storeId              String @db.Uuid
  createdByProfileId   String @db.Uuid
  tokenHash            String @unique
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  expiresAt            DateTime? @db.Timestamptz(6)
  kind                 String @default("LEGACY_LINK")
  codeHash             String? @unique
  codeNonce            Int?
  creationDigest       String?
  maxUses              Int? @default(1)
  useCount             Int @default(0)
  revokedAt            DateTime? @db.Timestamptz(6)
  acceptedAt           DateTime? @db.Timestamptz(6)
  acceptedByProfileId  String? @db.Uuid
  acceptedMembershipId String? @db.Uuid
  store                Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  creator              Profile @relation("InvitationCreator", fields: [createdByProfileId], references: [id], onDelete: Restrict)
  acceptor             Profile? @relation("InvitationAcceptor", fields: [acceptedByProfileId], references: [id], onDelete: Restrict)
  acceptedMembership   Membership? @relation(fields: [acceptedMembershipId], references: [id], onDelete: Restrict)
  outboxEvents OutboxEvent[]
  uses InvitationUse[]

  @@unique([id, storeId])
  @@index([storeId, createdAt, id])
  @@schema("app")
}

model InvitationUse {
  id           String @id @default(uuid()) @db.Uuid
  invitationId String @db.Uuid
  storeId      String @db.Uuid
  profileId    String @db.Uuid
  membershipId String @unique @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  invitation   Invitation @relation(fields: [invitationId, storeId], references: [id, storeId], onDelete: Restrict)
  membership   Membership @relation(fields: [membershipId, storeId, profileId], references: [id, storeId, profileId], onDelete: Restrict)
  outboxEvent OutboxEvent?

  @@index([invitationId, createdAt, id])
  @@schema("app")
}

model StoreAudit {
  id             String @id @default(uuid()) @db.Uuid
  storeId        String @db.Uuid
  actorProfileId String @db.Uuid
  action         String
  targetId       String? @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  store          Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  actor          Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)

  @@index([storeId, createdAt, id])
  @@schema("app")
}

model Conversation {
  id String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  participantMembershipId String @db.Uuid
  subjectType ConversationSubject
  subjectId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  commentsClosedAt DateTime? @db.Timestamptz(6)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  participantMembership Membership @relation(fields: [participantMembershipId], references: [id], onDelete: Restrict)
  comments Comment[]
  reactions Reaction[]
  reactionEvents ReactionEvent[]

  @@unique([subjectType, subjectId])
  @@unique([id, storeId])
  @@index([storeId, participantMembershipId])
  @@schema("app")
}

model Comment {
  id String @id @db.Uuid
  conversationId String @db.Uuid
  authorProfileId String @db.Uuid
  text String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  author Profile @relation(fields: [authorProfileId], references: [id], onDelete: Restrict)
  outboxEvents OutboxEvent[]

  @@index([conversationId, createdAt, id])
  @@schema("app")
}

model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  key String @unique
  kind NotificationKind
  storeId String @db.Uuid
  participantMembershipId String @db.Uuid
  actorProfileId String @db.Uuid
  recipientMembershipId String @db.Uuid
  invitationId String? @db.Uuid
  invitationUseId String? @unique @db.Uuid
  commentId String? @db.Uuid
  submissionId String? @db.Uuid
  reviewEventId String? @db.Uuid
  redemptionId String? @db.Uuid
  redemptionEventId String? @db.Uuid
  albumEventId String? @db.Uuid
  noteVersionId String? @db.Uuid
  reactionEventId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  availableAt DateTime @default(now()) @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6)
  attempts Int @default(0)
  lastErrorCode String?
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  participantMembership Membership @relation("EventParticipant", fields: [participantMembershipId], references: [id], onDelete: Restrict)
  actor Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)
  recipientMembership Membership @relation("EventRecipient", fields: [recipientMembershipId], references: [id], onDelete: Restrict)
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  invitationUse InvitationUse? @relation(fields: [invitationUseId], references: [id], onDelete: Restrict)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Restrict)
  submission ActivitySubmission? @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  reviewEvent SubmissionReviewEvent? @relation(fields: [reviewEventId], references: [id], onDelete: Restrict)
  redemption Redemption? @relation(fields: [redemptionId], references: [id], onDelete: Restrict)
  redemptionEvent RedemptionEvent? @relation(fields: [redemptionEventId], references: [id], onDelete: Restrict)
  albumEvent AlbumEvent? @relation(fields: [albumEventId], references: [id], onDelete: Restrict)
  noteVersion NoteVersion? @relation(fields: [noteVersionId], references: [id], onDelete: Restrict)
  reactionEvent ReactionEvent? @relation(fields: [reactionEventId], references: [id], onDelete: Restrict)
  notification Notification?

  @@index([processedAt, availableAt, id])
  @@index([recipientMembershipId, createdAt, id])
  @@schema("app")
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  eventId String @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  readAt DateTime? @db.Timestamptz(6)
  groupId String? @db.Uuid
  groupVersion Int?
  event OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  group NotificationGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@unique([groupId, groupVersion])
  @@index([createdAt, id])
  @@schema("app")
}

model PersonalNote {
  id String @id @db.Uuid
  storeId String @db.Uuid
  participantMembershipId String @unique @db.Uuid
  version Int
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  participant Membership @relation(fields: [participantMembershipId], references: [id], onDelete: Restrict)
  versions NoteVersion[]

  @@unique([id, storeId, participantMembershipId])
  @@schema("app")
}

model NoteVersion {
  id String @id @db.Uuid
  noteId String @db.Uuid
  storeId String @db.Uuid
  participantMembershipId String @db.Uuid
  actorProfileId String @db.Uuid
  version Int
  text String
  requestDigest String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  note PersonalNote @relation(fields: [noteId], references: [id], onDelete: Restrict)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  participant Membership @relation(fields: [participantMembershipId], references: [id], onDelete: Restrict)
  actor Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)
  reads NoteRead[]
  outboxEvents OutboxEvent[]

  @@unique([noteId, version])
  @@unique([id, storeId, participantMembershipId])
  @@index([storeId, participantMembershipId, createdAt, id])
  @@schema("app")
}

model NoteRead {
  noteVersionId String @db.Uuid
  readerMembershipId String @db.Uuid
  actorProfileId String @db.Uuid
  readAt DateTime @default(now()) @db.Timestamptz(6)
  version NoteVersion @relation(fields: [noteVersionId], references: [id], onDelete: Restrict)
  reader Membership @relation(fields: [readerMembershipId], references: [id], onDelete: Restrict)
  actor Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)

  @@id([noteVersionId, readerMembershipId])
  @@schema("app")
}

model Reaction {
  id String @id @db.Uuid
  storeId String @db.Uuid
  conversationId String @db.Uuid
  actorProfileId String @db.Uuid
  version Int
  emoji String?
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  actor Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)
  events ReactionEvent[]

  @@unique([conversationId, actorProfileId])
  @@unique([id, storeId, conversationId, actorProfileId])
  @@schema("app")
}

model ReactionEvent {
  id String @id @db.Uuid
  reactionId String @db.Uuid
  storeId String @db.Uuid
  conversationId String @db.Uuid
  actorProfileId String @db.Uuid
  version Int
  fromEmoji String?
  toEmoji String?
  requestDigest String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  reaction Reaction @relation(fields: [reactionId], references: [id], onDelete: Restrict)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  actor Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)
  outboxEvents OutboxEvent[]

  @@unique([reactionId, version])
  @@unique([id, storeId])
  @@index([storeId, createdAt, id])
  @@schema("app")
}

model NotificationGroup {
  id String @id @db.Uuid
  key String @unique
  storeId String @db.Uuid
  recipientMembershipId String @db.Uuid
  actorProfileId String @db.Uuid
  category String
  version Int
  lastDeliveredAt DateTime @db.Timestamptz(6)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  recipient Membership @relation(fields: [recipientMembershipId], references: [id], onDelete: Restrict)
  actor Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@index([recipientMembershipId, lastDeliveredAt, id])
  @@schema("app")
}

model NotificationPreference {
  membershipId String @id @db.Uuid
  storeId String @db.Uuid
  version Int
  socialMuted Boolean @default(false)
  automaticApprovalNotices Boolean @default(true)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@schema("app")
}

model NotificationPreferenceEvent {
  id String @id @db.Uuid
  membershipId String @db.Uuid
  storeId String @db.Uuid
  actorProfileId String @db.Uuid
  version Int
  requestDigest String
  socialMuted Boolean
  automaticApprovalNotices Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  actor Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)

  @@unique([membershipId, version])
  @@index([storeId, createdAt, id])
  @@schema("app")
}

model AdminGrant {
  profileId String    @id @db.Uuid
  grantedAt DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@schema("app")
}

model AdminAction {
  id String @id @db.Uuid
  actorProfileId String @db.Uuid
  targetProfileId String? @db.Uuid
  targetStoreId String? @db.Uuid
  kind String
  expectedVersion Int
  version Int
  reason String
  requestDigest String
  previousRestrictedAt DateTime? @db.Timestamptz(6)
  restrictedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  actor Profile @relation("AdminActor", fields: [actorProfileId], references: [id], onDelete: Restrict)
  targetProfile Profile? @relation("AdminTargetProfile", fields: [targetProfileId], references: [id], onDelete: Restrict)
  targetStore Store? @relation(fields: [targetStoreId], references: [id], onDelete: Restrict)

  @@unique([targetProfileId, version])
  @@unique([targetStoreId, version])
  @@index([targetProfileId, createdAt, id])
  @@index([targetStoreId, createdAt, id])
  @@index([actorProfileId, createdAt, id])
  @@schema("app")
}

model MediaCollection {
  id String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  participantMembershipId String @db.Uuid
  purpose MediaPurpose
  subjectId String @db.Uuid
  revision Int @default(1)
  uploadsClosedAt DateTime? @db.Timestamptz(6)
  retentionHold Boolean @default(true)
  retentionUntil DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  participantMembership Membership @relation(fields: [participantMembershipId], references: [id], onDelete: Restrict)
  assets MediaAsset[]
  ticketAlbum TicketAlbum?

  @@unique([purpose, subjectId])
  @@unique([id, storeId])
  @@index([storeId, participantMembershipId])
  @@schema("app")
}

model MediaAsset {
  id String @id @db.Uuid
  collectionId String @db.Uuid
  authorProfileId String @db.Uuid
  revision Int
  mediaType MediaType
  mimeType String
  byteLength Int
  sha256 String
  state MediaState @default(UPLOADING)
  uploadedBytes Int @default(0)
  failureCode String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  lastActivityAt DateTime @default(now()) @db.Timestamptz(6)
  leaseToken String? @db.Uuid
  leaseUntil DateTime? @db.Timestamptz(6)
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(6)
  outputVersion String? @db.Uuid
  processedAt DateTime? @db.Timestamptz(6)
  publishedAt DateTime? @db.Timestamptz(6)
  removedAt DateTime? @db.Timestamptz(6)
  purgedAt DateTime? @db.Timestamptz(6)
  width Int?
  height Int?
  durationMs Int?
  displayBytes Int?
  thumbnailBytes Int?
  collection MediaCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  author Profile @relation(fields: [authorProfileId], references: [id], onDelete: Restrict)
  parts MediaPart[]
  submissionEvidence ActivitySubmission?
  reviewEvidence SubmissionReviewEvent?
  albumItem AlbumItem?
  albumRemoval AlbumEvent? @relation("AlbumRemoval")

  @@index([collectionId, revision, createdAt, id])
  @@index([state, availableAt, leaseUntil])
  @@schema("app")
}

model MediaPart {
  assetId String @db.Uuid
  offset Int
  byteLength Int
  sha256 String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([assetId, offset])
  @@schema("app")
}

model Activity {
  id String @id @db.Uuid
  storeId String @db.Uuid
  createdByProfileId String @db.Uuid
  name String
  description String @default("")
  category String @default("")
  sticker String @default("")
  points Int
  frequency ActivityFrequency @default(DAILY)
  weeklyLimit Int @default(1)
  approvalMode ApprovalMode @default(MANUAL)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  creator Profile @relation(fields: [createdByProfileId], references: [id], onDelete: Restrict)
  events ActivityEvent[]
  submissions ActivitySubmission[]

  @@unique([id, storeId])
  @@index([storeId, archivedAt, createdAt, id])
  @@schema("app")
}

model ActivityEvent {
  id String @id @db.Uuid
  storeId String @db.Uuid
  activityId String @db.Uuid
  actorProfileId String @db.Uuid
  version Int
  kind String
  requestDigest String
  configuration Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  actor Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)

  @@unique([activityId, version])
  @@index([storeId, createdAt, id])
  @@schema("app")
}

model ActivitySubmission {
  id String @id @db.Uuid
  storeId String @db.Uuid
  activityId String @db.Uuid
  participantMembershipId String @db.Uuid
  authorProfileId String @db.Uuid
  status SubmissionStatus @default(DRAFT)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  receivedAt DateTime? @db.Timestamptz(6)
  approvedAt DateTime? @db.Timestamptz(6)
  analysisVersion Int @default(0)
  requestDigest String?
  activityVersion Int?
  activityName String?
  activityDescription String?
  activityCategory String?
  activitySticker String?
  points Int?
  frequency ActivityFrequency?
  weeklyLimit Int?
  approvalMode ApprovalMode?
  caption String @default("")
  timezone String?
  localDate String? @db.VarChar(10)
  periodKey String?
  periodStart DateTime? @db.Timestamptz(6)
  periodEnd DateTime? @db.Timestamptz(6)
  occurrenceNumber Int?
  evidenceAssetId String? @unique @db.Uuid
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  participant Membership @relation(fields: [participantMembershipId], references: [id], onDelete: Restrict)
  author Profile @relation(fields: [authorProfileId], references: [id], onDelete: Restrict)
  evidence MediaAsset? @relation(fields: [evidenceAssetId], references: [id], onDelete: Restrict)
  events SubmissionEvent[]
  pointsEntries PointsEntry[]
  outboxEvents OutboxEvent[]
  reviewEvents SubmissionReviewEvent[]

  @@unique([id, storeId])
  @@unique([id, storeId, participantMembershipId])
  @@unique([activityId, participantMembershipId, frequency, periodKey, occurrenceNumber])
  @@index([activityId, participantMembershipId, receivedAt])
  @@index([storeId, participantMembershipId, status, receivedAt, id])
  @@schema("app")
}

model SubmissionEvent {
  id String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  submissionId String @db.Uuid
  actorProfileId String @db.Uuid
  kind String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
