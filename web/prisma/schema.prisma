generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

enum MembershipRole {
  MERCHANT
  PARTICIPANT

  @@schema("app")
}

enum StoreState {
  ACTIVE
  PAUSED
  CLOSED

  @@schema("app")
}

enum ConversationSubject {
  SUBMISSION
  TICKET

  @@schema("app")
}

enum NotificationKind {
  INVITATION_ACCEPTED
  COMMENT_CREATED
  SUBMISSION_RECEIVED
  SUBMISSION_REVIEWED
  SUBMISSION_RESPONDED
  REDEMPTION_ISSUED

  @@schema("app")
}

enum ActivityFrequency {
  ONCE
  DAILY
  WEEKLY
  @@schema("app")
}

enum ApprovalMode {
  MANUAL
  AUTOMATIC
  @@schema("app")
}

enum RedemptionStatus {
  WAITING_AGREEMENT
  AGREED
  FULFILLED
  CANCELLATION_REQUESTED
  CANCELLED
  @@schema("app")
}

enum SubmissionStatus {
  DRAFT
  PENDING
  APPROVED
  CONTESTED
  VOIDED
  @@schema("app")
}

enum MediaPurpose {
  EVIDENCE
  MEMORY
  @@schema("app")
}

enum MediaType {
  PHOTO
  VIDEO
  @@schema("app")
}

enum MediaState {
  UPLOADING
  QUEUED
  PROCESSING
  READY
  FAILED
  REMOVING
  REMOVED
  @@schema("app")
}

model Profile {
  id             String          @id @db.Uuid
  displayName    String?
  suspendedAt    DateTime?       @db.Timestamptz(6)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  authoredStores Store[]
  memberships    Membership[]
  adminGrant     AdminGrant?
  authSessions   AuthSession[]
  securityAudits SecurityAudit[]
  createdInvitations Invitation[] @relation("InvitationCreator")
  acceptedInvitations Invitation[] @relation("InvitationAcceptor")
  storeAudits StoreAudit[]
  authoredComments Comment[]
  mediaAssets MediaAsset[]
  outboxEvents OutboxEvent[]

  authoredActivities Activity[]
  activityEvents ActivityEvent[]
  authoredSubmissions ActivitySubmission[]
  submissionEvents SubmissionEvent[]
  pointsEntries PointsEntry[]
  reviewEvents SubmissionReviewEvent[]
  authoredRewards Reward[]
  rewardEvents RewardEvent[]
  authoredRedemptions Redemption[]
  redemptionEvents RedemptionEvent[]

  @@schema("app")
}

model Store {
  id                 String       @id @default(uuid()) @db.Uuid
  createdByProfileId String       @db.Uuid
  name               String?
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  presentation       String       @default("")
  timezone           String       @default("America/Sao_Paulo")
  state              StoreState   @default(ACTIVE)
  pausedAt           DateTime?    @db.Timestamptz(6)
  closedAt           DateTime?    @db.Timestamptz(6)
  domainStartedAt    DateTime?    @db.Timestamptz(6)
  operationId        String?      @unique @db.Uuid
  creationDigest     String?
  createdBy          Profile      @relation(fields: [createdByProfileId], references: [id], onDelete: Restrict)
  memberships        Membership[]
  invitations        Invitation[]
  audits             StoreAudit[]
  conversations Conversation[]
  mediaCollections MediaCollection[]
  outboxEvents OutboxEvent[]

  activities Activity[]
  activityEvents ActivityEvent[]
  submissions ActivitySubmission[]
  submissionEvents SubmissionEvent[]
  pointsEntries PointsEntry[]
  reviewEvents SubmissionReviewEvent[]
  rewards Reward[]
  rewardEvents RewardEvent[]
  redemptions Redemption[]
  redemptionEvents RedemptionEvent[]

  @@index([createdByProfileId])
  @@schema("app")
}

model Membership {
  id              String         @id @default(uuid()) @db.Uuid
  storeId         String         @db.Uuid
  profileId       String         @db.Uuid
  role            MembershipRole
  accessRevokedAt DateTime?      @db.Timestamptz(6)
  closedAt        DateTime?      @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  profile         Profile        @relation(fields: [profileId], references: [id], onDelete: Restrict)
  acceptedInvitations Invitation[]
  participantConversations Conversation[]
  mediaCollections MediaCollection[]
  participantEvents OutboxEvent[] @relation("EventParticipant")
  receivedEvents OutboxEvent[] @relation("EventRecipient")
  submissions ActivitySubmission[]
  pointsEntries PointsEntry[]

  redemptions Redemption[]

  @@unique([storeId, profileId])
  @@unique([id, storeId])
  @@unique([id, profileId])
  @@index([profileId, accessRevokedAt])
  @@index([storeId, accessRevokedAt])
  @@schema("app")
}

model Invitation {
  id                   String @id @db.Uuid
  storeId              String @db.Uuid
  createdByProfileId   String @db.Uuid
  tokenHash            String @unique
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  expiresAt            DateTime @db.Timestamptz(6)
  revokedAt            DateTime? @db.Timestamptz(6)
  acceptedAt           DateTime? @db.Timestamptz(6)
  acceptedByProfileId  String? @db.Uuid
  acceptedMembershipId String? @db.Uuid
  store                Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  creator              Profile @relation("InvitationCreator", fields: [createdByProfileId], references: [id], onDelete: Restrict)
  acceptor             Profile? @relation("InvitationAcceptor", fields: [acceptedByProfileId], references: [id], onDelete: Restrict)
  acceptedMembership   Membership? @relation(fields: [acceptedMembershipId], references: [id], onDelete: Restrict)
  outboxEvents OutboxEvent[]

  @@index([storeId, createdAt, id])
  @@schema("app")
}

model StoreAudit {
  id             String @id @default(uuid()) @db.Uuid
  storeId        String @db.Uuid
  actorProfileId String @db.Uuid
  action         String
  targetId       String? @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  store          Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  actor          Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)

  @@index([storeId, createdAt, id])
  @@schema("app")
}

model Conversation {
  id String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  participantMembershipId String @db.Uuid
  subjectType ConversationSubject
  subjectId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  commentsClosedAt DateTime? @db.Timestamptz(6)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  participantMembership Membership @relation(fields: [participantMembershipId], references: [id], onDelete: Restrict)
  comments Comment[]

  @@unique([subjectType, subjectId])
  @@index([storeId, participantMembershipId])
  @@schema("app")
}

model Comment {
  id String @id @db.Uuid
  conversationId String @db.Uuid
  authorProfileId String @db.Uuid
  text String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  author Profile @relation(fields: [authorProfileId], references: [id], onDelete: Restrict)
  outboxEvents OutboxEvent[]

  @@index([conversationId, createdAt, id])
  @@schema("app")
}

model OutboxEvent {
  id String @id @default(uuid()) @db.Uuid
  key String @unique
  kind NotificationKind
  storeId String @db.Uuid
  participantMembershipId String @db.Uuid
  actorProfileId String @db.Uuid
  recipientMembershipId String @db.Uuid
  invitationId String? @db.Uuid
  commentId String? @db.Uuid
  submissionId String? @db.Uuid
  reviewEventId String? @db.Uuid
  redemptionId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  availableAt DateTime @default(now()) @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6)
  attempts Int @default(0)
  lastErrorCode String?
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  participantMembership Membership @relation("EventParticipant", fields: [participantMembershipId], references: [id], onDelete: Restrict)
  actor Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)
  recipientMembership Membership @relation("EventRecipient", fields: [recipientMembershipId], references: [id], onDelete: Restrict)
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Restrict)
  submission ActivitySubmission? @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  reviewEvent SubmissionReviewEvent? @relation(fields: [reviewEventId], references: [id], onDelete: Restrict)
  redemption Redemption? @relation(fields: [redemptionId], references: [id], onDelete: Restrict)
  notification Notification?

  @@index([processedAt, availableAt, id])
  @@index([recipientMembershipId, createdAt, id])
  @@schema("app")
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  eventId String @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  readAt DateTime? @db.Timestamptz(6)
  event OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@index([createdAt, id])
  @@schema("app")
}

model AdminGrant {
  profileId String    @id @db.Uuid
  grantedAt DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@schema("app")
}

model MediaCollection {
  id String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  participantMembershipId String @db.Uuid
  purpose MediaPurpose
  subjectId String @db.Uuid
  revision Int @default(1)
  uploadsClosedAt DateTime? @db.Timestamptz(6)
  retentionHold Boolean @default(true)
  retentionUntil DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  participantMembership Membership @relation(fields: [participantMembershipId], references: [id], onDelete: Restrict)
  assets MediaAsset[]

  @@unique([purpose, subjectId])
  @@unique([id, storeId])
  @@index([storeId, participantMembershipId])
  @@schema("app")
}

model MediaAsset {
  id String @id @db.Uuid
  collectionId String @db.Uuid
  authorProfileId String @db.Uuid
  revision Int
  mediaType MediaType
  mimeType String
  byteLength Int
  sha256 String
  state MediaState @default(UPLOADING)
  uploadedBytes Int @default(0)
  failureCode String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  lastActivityAt DateTime @default(now()) @db.Timestamptz(6)
  leaseToken String? @db.Uuid
  leaseUntil DateTime? @db.Timestamptz(6)
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(6)
  outputVersion String? @db.Uuid
  processedAt DateTime? @db.Timestamptz(6)
  publishedAt DateTime? @db.Timestamptz(6)
  removedAt DateTime? @db.Timestamptz(6)
  purgedAt DateTime? @db.Timestamptz(6)
  width Int?
  height Int?
  durationMs Int?
  displayBytes Int?
  thumbnailBytes Int?
  collection MediaCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  author Profile @relation(fields: [authorProfileId], references: [id], onDelete: Restrict)
  parts MediaPart[]
  submissionEvidence ActivitySubmission?
  reviewEvidence SubmissionReviewEvent?

  @@index([collectionId, revision, createdAt, id])
  @@index([state, availableAt, leaseUntil])
  @@schema("app")
}

model MediaPart {
  assetId String @db.Uuid
  offset Int
  byteLength Int
  sha256 String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  asset MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@id([assetId, offset])
  @@schema("app")
}

model Activity {
  id String @id @db.Uuid
  storeId String @db.Uuid
  createdByProfileId String @db.Uuid
  name String
  description String @default("")
  category String @default("")
  sticker String @default("")
  points Int
  frequency ActivityFrequency @default(DAILY)
  weeklyLimit Int @default(1)
  approvalMode ApprovalMode @default(MANUAL)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  creator Profile @relation(fields: [createdByProfileId], references: [id], onDelete: Restrict)
  events ActivityEvent[]
  submissions ActivitySubmission[]

  @@unique([id, storeId])
  @@index([storeId, archivedAt, createdAt, id])
  @@schema("app")
}

model ActivityEvent {
  id String @id @db.Uuid
  storeId String @db.Uuid
  activityId String @db.Uuid
  actorProfileId String @db.Uuid
  version Int
  kind String
  requestDigest String
  configuration Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  actor Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)

  @@unique([activityId, version])
  @@index([storeId, createdAt, id])
  @@schema("app")
}

model ActivitySubmission {
  id String @id @db.Uuid
  storeId String @db.Uuid
  activityId String @db.Uuid
  participantMembershipId String @db.Uuid
  authorProfileId String @db.Uuid
  status SubmissionStatus @default(DRAFT)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  receivedAt DateTime? @db.Timestamptz(6)
  approvedAt DateTime? @db.Timestamptz(6)
  analysisVersion Int @default(0)
  requestDigest String?
  activityVersion Int?
  activityName String?
  activityDescription String?
  activityCategory String?
  activitySticker String?
  points Int?
  frequency ActivityFrequency?
  weeklyLimit Int?
  approvalMode ApprovalMode?
  caption String @default("")
  timezone String?
  localDate String? @db.VarChar(10)
  periodKey String?
  periodStart DateTime? @db.Timestamptz(6)
  periodEnd DateTime? @db.Timestamptz(6)
  occurrenceNumber Int?
  evidenceAssetId String? @unique @db.Uuid
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  participant Membership @relation(fields: [participantMembershipId], references: [id], onDelete: Restrict)
  author Profile @relation(fields: [authorProfileId], references: [id], onDelete: Restrict)
  evidence MediaAsset? @relation(fields: [evidenceAssetId], references: [id], onDelete: Restrict)
  events SubmissionEvent[]
  pointsEntries PointsEntry[]
  outboxEvents OutboxEvent[]
  reviewEvents SubmissionReviewEvent[]

  @@unique([id, storeId])
  @@unique([id, storeId, participantMembershipId])
  @@unique([activityId, participantMembershipId, frequency, periodKey, occurrenceNumber])
  @@index([activityId, participantMembershipId, receivedAt])
  @@index([storeId, participantMembershipId, status, receivedAt, id])
  @@schema("app")
}

model SubmissionEvent {
  id String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  submissionId String @db.Uuid
  actorProfileId String @db.Uuid
  kind String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  submission ActivitySubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  actor Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)

  @@unique([submissionId, kind])
  @@index([storeId, createdAt, id])
  @@schema("app")
}

model PointsEntry {
  id String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  participantMembershipId String @db.Uuid
  submissionId String? @db.Uuid
  redemptionId String? @unique @db.Uuid
  actorProfileId String @db.Uuid
  kind String
  amount BigInt
  sourceKey String @unique
  reviewEventId String? @unique @db.Uuid
  compensatesEntryId String? @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  participant Membership @relation(fields: [participantMembershipId], references: [id], onDelete: Restrict)
  submission ActivitySubmission? @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  redemption Redemption? @relation(fields: [redemptionId], references: [id], onDelete: Restrict)
  actor Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)
  reviewEvent SubmissionReviewEvent? @relation(fields: [reviewEventId], references: [id], onDelete: Restrict)
  compensates PointsEntry? @relation("PointsCompensation", fields: [compensatesEntryId], references: [id], onDelete: Restrict)
  compensation PointsEntry? @relation("PointsCompensation")

  @@unique([id, storeId, participantMembershipId, submissionId])
  @@index([storeId, participantMembershipId, createdAt, id])
  @@schema("app")
}

model Reward {
  id String @id @db.Uuid
  storeId String @db.Uuid
  createdByProfileId String @db.Uuid
  name String
  description String @default("")
  category String @default("")
  sticker String @default("gift")
  cost Int
  note String @default("")
  instructions String @default("")
  available Boolean @default(true)
  stock Int?
  version Int @default(1)
  stockRevision Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  archivedAt DateTime? @db.Timestamptz(6)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  creator Profile @relation(fields: [createdByProfileId], references: [id], onDelete: Restrict)
  events RewardEvent[]
  redemptions Redemption[]

  @@unique([id, storeId])
  @@index([storeId, archivedAt, createdAt, id])
  @@schema("app")
}

model RewardEvent {
  id String @id @db.Uuid
  storeId String @db.Uuid
  rewardId String @db.Uuid
  actorProfileId String @db.Uuid
  version Int
  kind String
  requestDigest String
  configuration Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  actor Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)

  @@unique([rewardId, version])
  @@index([storeId, createdAt, id])
  @@schema("app")
}

model Redemption {
  id String @id @db.Uuid
  storeId String @db.Uuid
  rewardId String @db.Uuid
  participantMembershipId String @db.Uuid
  authorProfileId String @db.Uuid
  code String @unique
  status RedemptionStatus @default(WAITING_AGREEMENT)
  requestDigest String
  expectedBalance BigInt
  rewardVersion Int
  rewardName String
  rewardDescription String
  rewardCategory String
  rewardSticker String
  rewardCost Int
  rewardNote String
  rewardInstructions String
  balanceBefore BigInt
  balanceAfter BigInt
  stockBefore Int?
  stockAfter Int?
  stockRevision Int?
  timezone String
  localDate String @db.VarChar(10)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  participant Membership @relation(fields: [participantMembershipId], references: [id], onDelete: Restrict)
  author Profile @relation(fields: [authorProfileId], references: [id], onDelete: Restrict)
  events RedemptionEvent[]
  pointsEntries PointsEntry[]
  outboxEvents OutboxEvent[]

  @@unique([id, storeId, participantMembershipId])
  @@index([storeId, participantMembershipId, status, createdAt, id])
  @@schema("app")
}

model RedemptionEvent {
  id String @id @default(uuid()) @db.Uuid
  storeId String @db.Uuid
  redemptionId String @db.Uuid
  actorProfileId String @db.Uuid
  kind String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  redemption Redemption @relation(fields: [redemptionId], references: [id], onDelete: Restrict)
  actor Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)

  @@unique([redemptionId, kind])
  @@index([storeId, createdAt, id])
  @@schema("app")
}

model SubmissionReviewEvent {
  id String @id @db.Uuid
  storeId String @db.Uuid
  submissionId String @db.Uuid
  actorProfileId String @db.Uuid
  version Int
  action String
  fromStatus SubmissionStatus
  toStatus SubmissionStatus
  reason String @default("")
  text String @default("")
  requestDigest String
  evidenceAssetId String? @unique @db.Uuid
  evidenceRevision Int?
  requestId String? @unique @db.Uuid
  delta BigInt @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  submission ActivitySubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  actor Profile @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)
  evidence MediaAsset? @relation(fields: [evidenceAssetId], references: [id], onDelete: Restrict)
  request SubmissionReviewEvent? @relation("ResponseRequest", fields: [requestId], references: [id], onDelete: Restrict)
  response SubmissionReviewEvent? @relation("ResponseRequest")
  pointsEntry PointsEntry?
  outboxEvents OutboxEvent[]

  @@unique([submissionId, version])
  @@unique([id, submissionId, storeId])
  @@index([storeId, createdAt, id])
  @@schema("app")
}

model AuthSession {
  id        String    @id @db.Uuid
  profileId String    @db.Uuid
  recovery  Boolean   @default(false)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@index([profileId, revokedAt])
  @@schema("app")
}

model AuthRateBucket {
  key      String     @id
  attempts DateTime[] @default([]) @db.Timestamptz(6)

  @@schema("app")
}

model SecurityAudit {
  id             String   @id @default(uuid()) @db.Uuid
  action         String
  actorProfileId String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  actor          Profile? @relation(fields: [actorProfileId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([actorProfileId, createdAt])
  @@schema("app")
}
