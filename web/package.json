{
  "name": "meu-mimo-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4301",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4301",
    "lint": "eslint . --max-warnings 0",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "pretypecheck": "prisma generate",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:integration": "node scripts/integration.mjs",
    "local:start": "node scripts/local-runtime.mjs start",
    "local:prepare": "node scripts/prepare-local.mjs",
    "db:migrate:create": "node scripts/prisma-local.mjs create",
    "db:migrate:dev": "node scripts/prisma-local.mjs development",
    "db:migrate:integration": "node scripts/prisma-local.mjs integration",
    "db:migrate:status": "node scripts/prisma-local.mjs status",
    "db:migrate:check": "node scripts/check-migrations.mjs",
    "test:e2e": "playwright test",
    "prebuild": "prisma generate",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "dotenv": "18.0.8",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "globals": "16.4.0",
    "postcss": "8.5.23",
    "prisma": "7.10.1",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
